{"nodes": [{"id": "docs_design_sleep_consolidation_sleep_consolidation", "label": "Sleep Consolidation", "file_type": "document", "source_file": "docs/design/sleep-consolidation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_sleep_consolidation_t0_t1_authority_tiers", "label": "T0 Rule Half and T1 Judged Half", "file_type": "rationale", "source_file": "docs/design/sleep-consolidation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The deterministic T0 half settles dates, weight, links and directories by rule; the judged T1 half drafts proposals from a menu the core wrote, capped per kind per sleep, so nobody has to approve a sleep."}, {"id": "docs_design_sleep_consolidation_reversible_manage_operations", "label": "Reversible Unattended Operations", "file_type": "rationale", "source_file": "docs/design/sleep-consolidation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No operation removes a file: invalidation ends the validity interval and keeps the file for historical reads; physical removal is a human-run command the sleep layer cannot reach, so a wrong call stays reversible."}, {"id": "docs_design_sleep_consolidation_one_commit_per_sleep", "label": "One Report and One Commit Per Sleep", "file_type": "rationale", "source_file": "docs/design/sleep-consolidation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every sleep leaves a report and, when the store lives in a repository, a single commit, keeping each pass auditable as one unit."}], "edges": [{"source": "docs_design_sleep_consolidation_t0_t1_authority_tiers", "target": "docs_design_management_operation_boundaries_t0_duplicate_supersession", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/design/sleep-consolidation.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "reversible_unattended_manage", "label": "Reversible Unattended Management", "nodes": ["agents_manage_never_destroys_information", "docs_design_sleep_consolidation_t0_t1_authority_tiers", "docs_design_sleep_consolidation_reversible_manage_operations", "docs_design_management_operation_boundaries_t0_duplicate_supersession", "docs_design_management_operation_boundaries_full_list_link_replacement"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/design/sleep-consolidation.md"}]}