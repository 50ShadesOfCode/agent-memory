{"nodes": [{"id": "agents_agent_invariants", "label": "AGENTS.md Invariants and Task Lifecycle", "file_type": "document", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_markdown_files_single_source_of_truth", "label": "Markdown Files Are the Single Source of Truth", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Markdown truth with rebuildable indexes buys migration freedom, git-ability, platform compatibility and user sovereignty; losing the index must never lose knowledge."}, {"id": "agents_single_write_path", "label": "Single Write Path", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agent writes and Manage rewrites share one validate-persist-project pipeline because two write paths inevitably diverge truth from projection silently."}, {"id": "agents_reads_never_mutate_truth", "label": "Reads Never Mutate Truth Files", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Usage stats go to the index access log only; weight is settled into frontmatter by Manage in batch, so recall never causes reindex churn or git noise."}, {"id": "agents_raw_append_only_distillation_projection", "label": "Raw Material Is Append-Only; Distillation Is a Projection", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anything missed by distillation must remain recoverable from the archive, so 'missed by the distiller' can never mean 'lost by the system'."}, {"id": "agents_no_llm_client_in_core", "label": "No LLM Client Inside the Library Core", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reasoning lives in the executor borrowing the host CLI or an operator-owned endpoint: zero keys to install, no implicit billing authority, and a core testable without a network."}, {"id": "agents_manage_never_destroys_information", "label": "Manage Never Destroys Information", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every Manage operation is reversible with per-kind caps and audit; physical removal is a human-run command Manage cannot reach, keeping unattended runs safe against memory poisoning."}, {"id": "agents_file_boundary_invalidation_atom", "label": "File Boundary = Invalidation Atom", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One file holds knowledge that expires as a whole; partial staleness inside a file would poison the whole file, so a memory is active or invalid, nothing in between."}, {"id": "agents_adapters_carry_zero_algorithm", "label": "Adapters Carry Zero Algorithm", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CLI, MCP and hooks collapse into the same core calls, because N entries times M behaviors is untestable."}, {"id": "agents_recall_held_fixed", "label": "Recall Held Fixed Across Write Experiments", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Benchmark score differences attribute to Write options only under identical Recall; the P2 experiment's validity rests on this."}], "edges": [{"source": "agents_markdown_files_single_source_of_truth", "target": "docs_design_projection_and_cache_indexes_are_rebuildable_caches", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_single_write_path", "target": "docs_design_write_path_single_write_pipeline", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_reads_never_mutate_truth", "target": "docs_design_read_paths_reads_never_mutate_truth", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_raw_append_only_distillation_projection", "target": "docs_design_write_path_distillation_is_projection", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_no_llm_client_in_core", "target": "docs_design_executor_reasoning_core_holds_no_model_client", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_manage_never_destroys_information", "target": "docs_design_sleep_consolidation_reversible_manage_operations", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_file_boundary_invalidation_atom", "target": "docs_design_identity_and_placement_active_or_invalid_atom", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, 