  "cards": [
    {
      "dot": "cyan",
      "title": "Write path — one pipeline for every writer",
      "items": [
        "Agent, hook, and sleep writes all pass the same validate → persist → project pipeline",
        "A batch rejects only the bad item; a failure restores files and re-projects",
        "Projection touches only the files a write changed — cost does not grow with store size"
      ]
    },
    {
      "dot": "emerald",
      "title": "Three read tracks",
      "items": [
        "MEMORY.md is injected as a byte prefix at session start — no tool call, cannot miss",
        "BM25 over the FTS5 index, with an optional vector plugin fused in by reciprocal-rank fusion",
        "The plain directory tree stays reachable with ls and grep when both fail",
        "Recall answers with paths, never pasted text; reads never mutate Markdown truth"
      ]
    },
    {
      "dot": "violet",
      "title": "Distillation at conversation boundaries",
      "items": [
        "The full transcript is archived before anything is distilled — missed never means lost",
        "Runs detached so the host turn ends without waiting on reasoning",
        "Failed rounds leave the archived backlog eligible for retry; a watermark prevents re-reads"
      ]
    },
    {
      "dot": "amber",
      "title": "Sleep & Manage — the M layer",
      "items": [
        "T0 rule-only actions (dates, weight, links, grouping) apply immediately",
        "T1 verdicts come from the reasoner, capped per kind per sleep",
        "Deletion only ever arrives as a proposal until the owner runs mem decide",
        "One dream report and one git commit per sleep"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust & safety",
      "items": [
        "Hooks fail silent: every path exits 0; trouble goes to the store's own redacted log",
        "Frontmatter validation rejects malformed or out-of-store writes at the chokepoint",
        "Recalled content is data, never instructions; the reasoning edge is the only network touch"
      ]
    },
    {
      "dot": "slate",
      "title": "Cache, not truth",
      "items": [
        "rm -rf .index/ && mem rebuild loses zero knowledge — enforced by a test",
        "Usage stats live in the index access log; weight settles back at sleep",
        "Writers serialize through one flock on the store"
      ]
    }
  ]
